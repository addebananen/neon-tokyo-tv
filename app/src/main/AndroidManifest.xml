<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Neon Home asks the TV to uninstall an app; the TV asks to be sure itself -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Neon Home's Bluetooth corner: which paired headphones and speakers are on, and connecting
         them. Android 12 and later ask once; older ones need the two legacy permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Voice search through the Siri Remote: the speech recognizer asks its caller for this,
         though the sound comes from the remote, never the TV's own microphone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Only granted over ADB, by hand: lets Neon Tokyo turn BluetoothHelper on for a press -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Only granted over ADB, by hand: lets Neon Tokyo switch its overlay service on itself -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Only granted over ADB, by hand: lets picture diagnostics ask the TV's compositor about
         video in other apps. Without it diagnostics show what the public APIs know -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- Projectivy Launcher, for the wallpaper provider's refresh broadcast -->
        <package android:name="com.spocky.projengmenu" />
        <!-- The Neon home screen lists and opens the TV's apps -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- ...and the TV's HDMI inputs, whose input services belong to the TV's own apps -->
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
    </queries>

    <application
        android:name=".LumeraApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Lumera">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lumera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Neon home screen. The alias below makes it the TV's home screen -->
        <activity
            android:name="com.lumera.app.launcher.NeonHomeActivity"
            android:exported="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:theme="@style/Theme.NeonHome" />

        <!-- Off until the TV setup script turns it on, through NeonHomeSwitch below: a second app
             that answers the Home button would make the TV ask which home screen to use -->
        <activity-alias
            android:name="${applicationId}.NeonHome"
            android:enabled="false"
            android:exported="true"
            android:targetActivity="com.lumera.app.launcher.NeonHomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- How the TV setup script turns the alias above on and off. Only senders with this
             permission get through: the TV's shell and the system, never another app -->
        <receiver
            android:name="com.lumera.app.launcher.NeonHomeSwitch"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- Picture diagnostics and the gaming HUD over any app or console (Accessibility) -->
        <service
            android:name="com.lumera.app.overlay.NeonOverlayService"
            android:exported="true"
            android:label="@string/nt_overlay_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/neon_overlay" />
        </service>

        <!-- Lets the music widget see what plays in other apps. It is off until it is allowed over
             ADB (cmd notification allow_listener) and reads no notifications -->
        <service
            android:name="com.lumera.app.launcher.NowPlayingListener"
            android:exported="true"
            android:label="@string/nt_now_playing_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Presses Connect on the TV's own Bluetooth page, which Android 13 and later keep for
             the system. Off until Neon Tokyo turns it on for a press; it turns itself off after -->
        <service
            android:name="com.lumera.app.launcher.BluetoothHelper"
            android:exported="true"
            android:label="@string/nt_bluetooth_helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bluetooth_helper" />
        </service>

        <!-- Projectivy Launcher wallpaper provider: the skyline follows the focused app -->
        <service
            android:name=".projectivy.NeonWallpaperProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="tv.projectivy.plugin.WALLPAPER_PROVIDER" />
            </intent-filter>
            <meta-data android:name="apiVersion" android:value="1" />
            <meta-data android:name="uuid" android:value="@string/nt_wallpaper_provider_uuid" />
            <meta-data android:name="name" android:value="@string/app_name" />
            <!-- Resolved against the package name, which is the alias below -->
            <meta-data android:name="settingsActivity" android:value=".NeonWallpaperSettings" />
            <meta-data android:name="itemsCacheDurationMillis" android:value="3600000" />
            <!-- TIME_ELAPSED 1 + CARD_FOCUSED 4 + LAUNCHER_IDLE_MODE_CHANGED 16 -->
            <meta-data android:name="updateMode" android:value="21" />
        </service>

        <activity
            android:name=".projectivy.NeonWallpaperSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Lumera" />

        <!-- The classes live under com.lumera.app, the package is com.neontokyo.tv:
             this alias gives Projectivy a settings activity right under the package name -->
        <activity-alias
            android:name="${applicationId}.NeonWallpaperSettings"
            android:exported="true"
            android:targetActivity=".projectivy.NeonWallpaperSettingsActivity" />

        <!-- Screensaver -->
        <service
            android:name=".dream.NeonDreamService"
            android:exported="true"
            android:label="@string/nt_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Opened by the Siri Remote bridge (shell) when Siri is held -->
        <activity
            android:name=".siri.VoiceActivity"
            android:exported="true"
            android:taskAffinity="com.neontokyo.voice"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NeonVoice" />

        <activity
            android:name=".dream.NeonDreamPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Lumera" />

        <activity
            android:name=".ui.home.SceneArtPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Lumera" />

        <service
            android:name=".data.torrent.TorrentService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>