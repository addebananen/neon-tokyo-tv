<?xml version="1.0" encoding="utf-8"?>
<!-- Sees the remote's buttons for the chords and the Control Center, and which app is in front.
     It reads a screen only for a press the Control Center asks for on the TV's own Bluetooth or
     Wi-Fi page, and only while that press lasts -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/nt_overlay_description"
    android:notificationTimeout="150" />
