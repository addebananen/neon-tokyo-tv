{
  "name": "Neon Tokyo",
  "short_name": "Neon Tokyo",
  "description": "Films and series from your Stremio addons, with Neon Tokyo's look.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0D0721",
  "theme_color": "#0D0721",
  "categories": ["entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "TV remote", "url": "./remote/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "./#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Series", "url": "./#/series", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Movies", "url": "./#/movies", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
